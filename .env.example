# docker-compose.yml (開発用) と docker-compose.prod.yml (本番用) が読み込む設定。
# このファイルを .env にコピーして値を設定する (.env はコミットしない)

# DB のパスワード。アプリ用と root 用には、それぞれ別の値を使う (本番では推測困難な値にする)
# DB のボリュームを初めて作るときに設定される。後から変える場合は ALTER USER で変更してから合わせる
SAKKYOKU_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Django の秘密鍵。環境ごとに生成する (例: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
SAKKYOKU_SECRET_KEY=

# --- 開発用 ---
# Linux では、ホストの利用者の UID/GID (id -u / id -g の値) を設定する。macOS の Docker Desktop では不要
#SAKKYOKU_UID=1000
#SAKKYOKU_GID=1000

# --- 本番用 ---
# 公開するホスト名 (カンマ区切り)
#SAKKYOKU_ALLOWED_HOSTS=example.com
# HSTS の有効期間(秒)。HTTPS での動作を確認できたら 31536000 などに延ばす
#SAKKYOKU_SECURE_HSTS_SECONDS=3600
