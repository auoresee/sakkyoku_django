# docker-compose.yml が読み込む秘密情報。このファイルを .env にコピーして値を設定する
# アプリ用とroot用には、それぞれ別の推測困難なパスワードを使う
SAKKYOKU_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Djangoの秘密鍵。環境ごとに生成する (例: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
SAKKYOKU_SECRET_KEY=

# HSTSの有効期間(秒)。HTTPSでの動作を確認できたら 31536000 などに延ばす
#SAKKYOKU_SECURE_HSTS_SECONDS=3600
